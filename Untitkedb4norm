import { Normalizer } from './normalizer.js';

function assert(condition, message) {
  if (!condition) throw new Error(`❌ FAIL: ${message}`);
  console.log(`  ✓ PASS: ${message}`);
}

function runTests() {
  console.log('--- RUNNING NORMALIZER V1 SUITE ---');

  console.log('\n[Test 1] Valid spatial article normalization');
  const raw1 = {
    id: 'art-101',
    title: '  Sherwood Park Infrastructure Project  ',
    url: 'https://news.example.com/101',
    source: 'Local Gazette',
    publishedAt: '2026-09-30T09:00:00Z',
    category: 'Infrastructure',
    imageUrl: 'https://news.example.com/img1.jpg',
    location: { lat: 53.525, lng: -113.316, label: 'Sherwood Park, AB', approximate: false }
  };
  const res1 = Normalizer.normalizeItem(raw1);
  assert(res1.id === 'art-101', 'Preserves article ID');
  assert(res1.title === 'Sherwood Park Infrastructure Project', 'Trims whitespace');
  assert(res1.location !== null && res1.location.lat === 53.525, 'Extracts spatial coordinates');

  console.log('\n[Test 2] Null location handling');
  const raw2 = { title: 'Global Markets Update', category: 'Markets' };
  const res2 = Normalizer.normalizeItem(raw2);
  assert(res2.location === null, 'Sets location strictly to null when missing');

  console.log('\n[Test 3] Reject invalid coordinates');
  assert(Normalizer.normalizeItem({ location: { lat: 95.0, lng: -113.0 } }).location === null, 'Rejects lat > 90');
  assert(Normalizer.normalizeItem({ location: { lat: 53.0, lng: -200.0 } }).location === null, 'Rejects lng < -180');

  console.log('\n--- ALL SUITE TESTS PASSED SUCCESSFULLY ---');
}

runTests();
EOF

cat << 'EOF' > nesw.js
import NewsMapIndex from './newsMapIndex.js';
import Normalizer from './normalizer.js';

export class NESW {
  constructor(config = {}) {
    this.config = {
      viewport: { x: 0, y: 0, width: 1200, height: 800 },
      indexerOptions: {},
      ...config
    };
    
    this._engine = new NewsMapIndex(this.config.indexerOptions);
  }

  process(rawArticles = [], customViewport = null) {
    const viewport = customViewport || this.config.viewport;
    const normalizedArticles = Normalizer.normalizeBatch(rawArticles);
    const treeIndex = this._engine.buildIndex(normalizedArticles);
    const layoutTree = this._engine.computeLayout(treeIndex, viewport);
    const geocodedCount = normalizedArticles.filter(a => a.location !== null).length;

    return {
      meta: {
        version: '1.0.0',
        type: 'hybrid-spatial-treemap',
        computedAt: new Date().toISOString(),
        totalArticles: normalizedArticles.length,
        geocodedArticlesCount: geocodedCount,
        viewport
      },
      tree: layoutTree
    };
  }

  static render(articles, bounds, options = {}) {
    const instance = new NESW({ ...options, viewport: bounds });
    return instance.process(articles);
  }
}

export default NESW;
